# Project defaults for `idf.py set-target esp32s3` (applied on first build).

CONFIG_IDF_TARGET="esp32s3"

# All video assets live inside the app image: use the whole 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Single big factory app (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console output on the USB-to-UART port (115200 baud)...
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# ...and also mirrored on the native USB port.
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
